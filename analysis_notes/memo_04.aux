\newlabel{sec:findings}{{}{3}{Root Cause~1 --- Structural issues in the split advection path}{section*.7}{}}
\@writefile{toc}{\contentsline {paragraph}{Diagnostic interpretation: the \texttt  {adv*} heatmap signal is the expected open-boundary flux, not a conservation bug within the advection operator.}{3}{section*.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Stage mass-change heatmap for cases\nobreakspace  {}\texttt  {b} (left) and\nobreakspace  {}\texttt  {c} (right). Each row is one operator stage; each column is one reporting timestep. Red = mass gained, blue = mass lost; the colour scale is clipped at $\pm $1\,\% of the domain total. Dashed horizontal lines mark the five stages that must be exactly mass-conservative (\texttt  {adv*}, \texttt  {vdif*}, \texttt  {kin*}, \texttt  {MPI*}, \texttt  {recomb*}). The \texttt  {adv*} row is the only conservative stage showing non-zero values. Subsequent analysis (Section\nobreakspace  {}\ref {sec:findings}) confirms that this signal is the expected open-boundary advective exchange flux present in all cases, not a split-path conservation bug.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:heatmap}{{1}{4}{Stage mass-change heatmap for cases~\texttt {b} (left) and~\texttt {c} (right). Each row is one operator stage; each column is one reporting timestep. Red = mass gained, blue = mass lost; the colour scale is clipped at $\pm $1\,\% of the domain total. Dashed horizontal lines mark the five stages that must be exactly mass-conservative (\texttt {adv*}, \texttt {vdif*}, \texttt {kin*}, \texttt {MPI*}, \texttt {recomb*}). The \texttt {adv*} row is the only conservative stage showing non-zero values. Subsequent analysis (Section~\ref {sec:findings}) confirms that this signal is the expected open-boundary advective exchange flux present in all cases, not a split-path conservation bug}{figure.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Why the multi-class loop is mass-conservative but the floc split is not (for general parameters).}{5}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\texttt  {cflx} is concentration-nudge-only: the shared-array overwrite has zero effect on the simulation.}{5}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Flux-limiter asymmetry --- future issue when \texttt  {conc\_a}$>0$.}{5}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proposed Fix\nobreakspace  {}A (both versions withdrawn).}{5}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Fix\nobreakspace  {}D (future) --- multi-species flux limiting.}{6}{section*.13}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces 10-day Fix\nobreakspace  {}B+ in-run checkpoint summary (all cases clipped to 10\nobreakspace  {}days). Case\nobreakspace  {}c uses the corrected D50\nobreakspace  {}=\nobreakspace  {}1.0\nobreakspace  {}mm sediment parameterisation.}}{8}{table.1}\protected@file@percent }
\newlabel{tab:20day}{{1}{8}{10-day Fix~B+ in-run checkpoint summary (all cases clipped to 10~days). Case~c uses the corrected D50~=~1.0~mm sediment parameterisation}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Three-panel stage-delta heatmap, first 10\nobreakspace  {}comparison days, Fix\nobreakspace  {}B+ active on all cases. Case\nobreakspace  {}c uses the corrected D50\nobreakspace  {}=\nobreakspace  {}1.0\nobreakspace  {}mm sediment. Dashed rows = stages that must be exactly conservative. \emph  {Left (case\nobreakspace  {}a, non-floc)}: the active row is \texttt  {transport*} (CP3$\to $CP3p5), capturing horizontal advection and vertical diffusion; rows labelled \texttt  {(=0,NF)} are checkpoints of the same \texttt  {cnew} array and are zero by construction. \emph  {Centre (case\nobreakspace  {}b, floc, D50\nobreakspace  {}=\nobreakspace  {}0.1\nobreakspace  {}mm)}: only \texttt  {adv\_d*} (CP3p5$\to $CP4) is active (tidal OBC signal); dep/ero/bot and \texttt  {adv\_a*} remain blank because \texttt  {conc\_a}\nobreakspace  {}=\nobreakspace  {}0. \emph  {Right (case\nobreakspace  {}c corrected, floc, D50\nobreakspace  {}=\nobreakspace  {}1.0\nobreakspace  {}mm)}: four additional rows are active --- \texttt  {dep} (CP0$\to $CP1, max 3.55\nobreakspace  {}kg/step), \texttt  {ero} (CP1$\to $CP2), \texttt  {bot} (CP2$\to $CP3), and \texttt  {adv\_a*} (CP3$\to $CP3p5, max 2.2$\times $10$^{-2}$\nobreakspace  {}kg/step, confirming \texttt  {conc\_a}$>$0 from active floc kinetics).}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:heatmap_3case}{{2}{9}{Three-panel stage-delta heatmap, first 10~comparison days, Fix~B+ active on all cases. Case~c uses the corrected D50~=~1.0~mm sediment. Dashed rows = stages that must be exactly conservative. \emph {Left (case~a, non-floc)}: the active row is \texttt {transport*} (CP3$\to $CP3p5), capturing horizontal advection and vertical diffusion; rows labelled \texttt {(=0,NF)} are checkpoints of the same \texttt {cnew} array and are zero by construction. \emph {Centre (case~b, floc, D50~=~0.1~mm)}: only \texttt {adv\_d*} (CP3p5$\to $CP4) is active (tidal OBC signal); dep/ero/bot and \texttt {adv\_a*} remain blank because \texttt {conc\_a}~=~0. \emph {Right (case~c corrected, floc, D50~=~1.0~mm)}: four additional rows are active --- \texttt {dep} (CP0$\to $CP1, max 3.55~kg/step), \texttt {ero} (CP1$\to $CP2), \texttt {bot} (CP2$\to $CP3), and \texttt {adv\_a*} (CP3$\to $CP3p5, max 2.2$\times $10$^{-2}$~kg/step, confirming \texttt {conc\_a}$>$0 from active floc kinetics)}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Verdict: the Memo\nobreakspace  {}03 problem is \textbf  {fully solved};\break  sediment \texttt  {adv\_scal} is safe.}{9}{section*.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces 10-day domain total mass from NetCDF output (offline budget). \textbf  {v007}: case\nobreakspace  {}a without Fix\nobreakspace  {}B+; \textbf  {v008}: Fix\nobreakspace  {}B+ only (sed adv/FCT bypassed); \textbf  {v009}: Fix\nobreakspace  {}B+ with \texttt  {adv\_scal} active (no backward, no FCT).}}{10}{table.2}\protected@file@percent }
\newlabel{tab:netcdf}{{2}{10}{10-day domain total mass from NetCDF output (offline budget). \textbf {v007}: case~a without Fix~B+; \textbf {v008}: Fix~B+ only (sed adv/FCT bypassed); \textbf {v009}: Fix~B+ with \texttt {adv\_scal} active (no backward, no FCT)}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Domain-integrated mp1 total mass (water + bed) for all three cases over the 10-day Fix\nobreakspace  {}B+ run (v008, sed adv/FCT bypassed). All three lines are \emph  {indistinguishable}.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:v008_total}{{3}{11}{Domain-integrated mp1 total mass (water + bed) for all three cases over the 10-day Fix~B+ run (v008, sed adv/FCT bypassed). All three lines are \emph {indistinguishable}}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Domain-integrated mp1 total mass for v009: Fix\nobreakspace  {}B+ plus \texttt  {adv\_scal} active for sediment (\texttt  {adv\_scal\_backward} and \texttt  {fct\_sed} still disabled). All three cases remain indistinguishable at 1001.3\nobreakspace  {}kg, confirming that \texttt  {adv\_scal} does \emph  {not} corrupt the plastic scalar arrays.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:v009_total}{{4}{12}{Domain-integrated mp1 total mass for v009: Fix~B+ plus \texttt {adv\_scal} active for sediment (\texttt {adv\_scal\_backward} and \texttt {fct\_sed} still disabled). All three cases remain indistinguishable at 1001.3~kg, confirming that \texttt {adv\_scal} does \emph {not} corrupt the plastic scalar arrays}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces 10-day offline budget for the corrected three-case configuration. Case\nobreakspace  {}c now uses D50\nobreakspace  {}=\nobreakspace  {}1.0\nobreakspace  {}mm (\texttt  {generic\_sediment\_c.inp}). Cases\nobreakspace  {}a and\nobreakspace  {}b are unchanged from v008.}}{13}{table.3}\protected@file@percent }
\newlabel{tab:casec_corrected}{{3}{13}{10-day offline budget for the corrected three-case configuration. Case~c now uses D50~=~1.0~mm (\texttt {generic\_sediment\_c.inp}). Cases~a and~b are unchanged from v008}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Domain-integrated \texttt  {mp1} total mass (water\,+\,bed) for the corrected three-case configuration over 10\nobreakspace  {}days. Case\nobreakspace  {}c (D50\nobreakspace  {}=\nobreakspace  {}1.0\nobreakspace  {}mm, green) diverges from cases\nobreakspace  {}a and\nobreakspace  {}b by day\nobreakspace  {}2, reaching 1002.10\nobreakspace  {}kg ($\approx $0.85\nobreakspace  {}kg, 0.085\% higher). The difference reflects the altered OBC exchange flux associated with the higher bed roughness of the coarser sediment.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:v010_total}{{5}{14}{Domain-integrated \texttt {mp1} total mass (water\,+\,bed) for the corrected three-case configuration over 10~days. Case~c (D50~=~1.0~mm, green) diverges from cases~a and~b by day~2, reaching 1002.10~kg ($\approx $0.85~kg, 0.085\% higher). The difference reflects the altered OBC exchange flux associated with the higher bed roughness of the coarser sediment}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Water-column and bed mass partition for the corrected cases. Case\nobreakspace  {}c accumulates 23.09\nobreakspace  {}kg on the bed by day\nobreakspace  {}10 (2.3\% of the 10-day accumulated total), while cases\nobreakspace  {}a and\nobreakspace  {}b retain zero bed mass throughout.}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:v010_partition}{{6}{15}{Water-column and bed mass partition for the corrected cases. Case~c accumulates 23.09~kg on the bed by day~10 (2.3\% of the 10-day accumulated total), while cases~a and~b retain zero bed mass throughout}{figure.6}{}}
