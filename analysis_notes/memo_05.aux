\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Monitoring station coordinates and nearest model node used for time-series extraction.}}{2}{table.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:stations}{{1}{2}{Monitoring station coordinates and nearest model node used for time-series extraction}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Day-mean depth-averaged mp1 concentration [$\mathrm  {kg\,m^{-3}}$], final 24\nobreakspace  {}h of the 10-day run. Log colour scale. Cases\nobreakspace  {}a and\nobreakspace  {}b are visually identical (peak $1.7\times 10^{-4}$\nobreakspace  {}kg\,m$^{-3}$). Case\nobreakspace  {}c peak is $3.7\times 10^{-3}$\nobreakspace  {}kg\,m$^{-3}$ ($\approx $21$\times $ higher) due to active aggregation and altered settling.}}{3}{figure.caption.11}\protected@file@percent }
\newlabel{fig:davg_mp1}{{1}{3}{Day-mean depth-averaged mp1 concentration [$\mathrm {kg\,m^{-3}}$], final 24~h of the 10-day run. Log colour scale. Cases~a and~b are visually identical (peak $1.7\times 10^{-4}$~kg\,m$^{-3}$). Case~c peak is $3.7\times 10^{-3}$~kg\,m$^{-3}$ ($\approx $21$\times $ higher) due to active aggregation and altered settling}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Day-mean depth-averaged aggregated (\texttt  {mp1\_agg}) and disaggregated (\texttt  {mp1\_dis}) fractions, final 24\nobreakspace  {}h of the 10-day run. Case\nobreakspace  {}b: \texttt  {mp1\_agg}\nobreakspace  {}=\nobreakspace  {}0 everywhere (fine sediment, D50\nobreakspace  {}=\nobreakspace  {}0.1\nobreakspace  {}mm --- weak heteroaggregation kinetics). Case\nobreakspace  {}c: \texttt  {mp1\_agg} reaches $1.1\times 10^{-3}$\nobreakspace  {}kg\,m$^{-3}$ and is non-zero across most of the domain; \texttt  {mp1\_dis} mirrors the overall plume.}}{4}{figure.caption.13}\protected@file@percent }
\newlabel{fig:davg_agg}{{2}{4}{Day-mean depth-averaged aggregated (\texttt {mp1\_agg}) and disaggregated (\texttt {mp1\_dis}) fractions, final 24~h of the 10-day run. Case~b: \texttt {mp1\_agg}~=~0 everywhere (fine sediment, D50~=~0.1~mm --- weak heteroaggregation kinetics). Case~c: \texttt {mp1\_agg} reaches $1.1\times 10^{-3}$~kg\,m$^{-3}$ and is non-zero across most of the domain; \texttt {mp1\_dis} mirrors the overall plume}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Day-mean bed plastic mass density [$\mathrm  {kg\,m^{-2}}$], final 24\nobreakspace  {}h of the 10-day run. Cases\nobreakspace  {}a and\nobreakspace  {}b: zero bed mass throughout. Case\nobreakspace  {}c: widespread deposition (max $6.5\times 10^{-3}$\nobreakspace  {}kg\,m$^{-2}$; positive at 833\,468 nodes), concentrated near the upper-bay tributary junctions.}}{4}{figure.caption.15}\protected@file@percent }
\newlabel{fig:bot_mass}{{3}{4}{Day-mean bed plastic mass density [$\mathrm {kg\,m^{-2}}$], final 24~h of the 10-day run. Cases~a and~b: zero bed mass throughout. Case~c: widespread deposition (max $6.5\times 10^{-3}$~kg\,m$^{-2}$; positive at 833\,468 nodes), concentrated near the upper-bay tributary junctions}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Node-wise maximum depth-averaged mp1 concentration over the final 24\nobreakspace  {}h of the 10-day run. No isolated hotspot nodes disconnected from river sources are present in any case, confirming the absence of localized numerical accumulation.}}{4}{figure.caption.17}\protected@file@percent }
\newlabel{fig:max_mp1}{{4}{4}{Node-wise maximum depth-averaged mp1 concentration over the final 24~h of the 10-day run. No isolated hotspot nodes disconnected from river sources are present in any case, confirming the absence of localized numerical accumulation}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Day-mean depth-averaged mp1 difference maps [$\mathrm  {kg\,m^{-3}}$], final 24\nobreakspace  {}h of the 10-day run. Diverging colour scale (red\nobreakspace  {}=\nobreakspace  {}gain, blue\nobreakspace  {}=\nobreakspace  {}loss). \emph  {b$-$a}: near-zero everywhere --- cases\nobreakspace  {}a and\nobreakspace  {}b are identical (D50\nobreakspace  {}=\nobreakspace  {}0.1\nobreakspace  {}mm, no aggregation). \emph  {c$-$a} and \emph  {c$-$b}: case\nobreakspace  {}c shows elevated concentrations near river mouths (stronger local aggregation) and reduced concentrations further downstream (faster bed removal).}}{5}{figure.caption.19}\protected@file@percent }
\newlabel{fig:diff_mp1}{{5}{5}{Day-mean depth-averaged mp1 difference maps [$\mathrm {kg\,m^{-3}}$], final 24~h of the 10-day run. Diverging colour scale (red~=~gain, blue~=~loss). \emph {b$-$a}: near-zero everywhere --- cases~a and~b are identical (D50~=~0.1~mm, no aggregation). \emph {c$-$a} and \emph {c$-$b}: case~c shows elevated concentrations near river mouths (stronger local aggregation) and reduced concentrations further downstream (faster bed removal)}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Depth-averaged mp1 concentration time series at the eight monitoring stations over the full 10-day run. Blue: case\nobreakspace  {}a (no-floc); orange: case\nobreakspace  {}b (D50\nobreakspace  {}=\nobreakspace  {}0.1\nobreakspace  {}mm); green: case\nobreakspace  {}c (D50\nobreakspace  {}=\nobreakspace  {}1.0\nobreakspace  {}mm). Cases\nobreakspace  {}a and\nobreakspace  {}b are indistinguishable at all stations. Case\nobreakspace  {}c diverges from day\nobreakspace  {}2 onward at the upstream Delaware and Schuylkill stations, reflecting the onset of active aggregation and bed deposition under the coarser sediment parameterisation.}}{6}{figure.caption.21}\protected@file@percent }
\newlabel{fig:station_mp1}{{6}{6}{Depth-averaged mp1 concentration time series at the eight monitoring stations over the full 10-day run. Blue: case~a (no-floc); orange: case~b (D50~=~0.1~mm); green: case~c (D50~=~1.0~mm). Cases~a and~b are indistinguishable at all stations. Case~c diverges from day~2 onward at the upstream Delaware and Schuylkill stations, reflecting the onset of active aggregation and bed deposition under the coarser sediment parameterisation}{figure.caption.21}{}}
