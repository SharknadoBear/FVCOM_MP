!==============================================================================!
!   INPUT FILE FOR PARAMETERS CONTROLLING FVCOM PLASTIC MODEL                  !
!	(Modified based on generic_sediment input file)                            !
!        FORMAT:			                                       			   !
!       1.) VARIABLE  = VALUE  (EQUAL SIGN MUST BE USED)                       !
!       2.) FLOATING POINT VARIABLES MUST CONTAIN A PERIOD "." EX: 1.3, 2.,etc !
!       3.) BLANK LINES ARE IGNORED AS ARE LINES BEGINNING WITH ! (F90 COMMENT)!
!       4.) COMMENTS CAN FOLLOW VALUES IF MARKED BY !                          !
!       5.) ORDER OF VARIABLES IS NOT IMPORTANT                                !
!       6.) FOR MULTIPLE VALUE VARIABLES FIRST ENTRY IS NUMBER OF VARIABLES    !
!           TO FOLLOW (OR 0 IF NONE)                                           !
!       7.) DO NOT USE COMMAS TO SEPARATE VARIABLES                            !
!       8.) DO NOT EXCEED EIGHTY CHARACTERS PER LINE                           !
!       9.)  TRUE = T, FALSE = F                                               !
!                                                                              ! 
!  THE PREVIOUS FORMAT OF "VARIABLE: VALUE" IS NO LONGER VALID                 !
!  THE MORE ATTRACTIVE " = " FORMAT WAS SUGGESTED BY Hernan G. Arango          !
!                                                                              !
!------------------------------------------------------------------------------!
! Plastic Module Dynamics Parameters
!	PLAST_ONED: switch of 1D model
!	PLAST_NUDGE: switch of OBC nudging
!   PLAST_ALPHA: plastic nudging relaxation factor
!	PLAST_RAMP: number of iterations over which to ramp plastic nudging
!	PLAST_START: start interval for plastic model
!	PLAST_PTSOURCE: switch of plastic point source (river input)
!	PLAST_HOT_START: switch of plastic restart
!   PLAST_UNIT: plastic unit setting for computation
!				1) kg/m^3   (SI mass concentration unit)
!				2) g/l      (cgs mass concentration unit)
!				3) #/m^3    (SI number concentration unit)
!				4) #/l	    (Liter number concentration unit)
!	PLAST_BEDSET: Bottom treatment setting, there are five options in 
!       incorporating the dynamics with the bottom sediment bed
!				1) levitation: microplastics are levitated with no 
!					settling or resuspension fluxes
!				2) concrete_bottom: microplastics can settle down, or resuspend
!					but the interaction with the sediment bed is not considered
!				3) active_bottom: consider the microplastics interaction with
!					sediment inside an active layer (armored sediment layer) 
!				4) bedload_bottom: consider the horizontal movement of microplastics
!					with sediment through bedload, while the dynamics of 
!					microplastics inside the active bottom for resuspension and
!					settling is also considered through V.Chavarrias et al. (2019)
!				5) burial_bottom: consider infiltration of microplastics into 
!					layers below the active layer
!  CSHIEDS: treatment of critical shields parameter
!				1) R93: using the treatment from van Rijn 1993
!				2) SW97: using the treatment from Soulsby and Whitehouse 1997
!------------------------------------------------------------------------------!

PLAST_ONED = F
PLAST_NUDGE = F
PLAST_ALPHA = 0.5
PLAST_RAMP  = 1
PLAST_START = 361
PLAST_PTSOURCE = T
PLAST_HOT_START = F
PLAST_UNIT = kg/m^3
PLAST_BEDSET = concrete_bottom
CSHIELDS = SW97

!------------------------------------------------------------------------------!
! Plastic Settling Parameters 
!   SETTLE_CFL: set the CFL number for the settling scheme [>0, 1]
!   SETTLE_LIMITER: set the limiter type for the settling advection eq.
!            =0:  1st order upwind
!            =1:  minmod limiter
!            =2:  Van Leer limiter
!   
!------------------------------------------------------------------------------!

SETTLE_CFL = .8
SETTLE_LIMITER = 1

!------------------------------------------------------------------------------!
! Plastic Module Reporting and Archiving Control 
!   PLAST_DUMPBOT: (T/F) Dump all the bottom variables 
!------------------------------------------------------------------------------!

N_REPORT = 50
PLAST_DUMPBOT = F

!------------------------------------------------------------------------------!
! Micro Plastic Parameters
!   NPLAST:   number of suspended sediments
!   AMBIENT_DEN:   ambient seawater density	
!						(if constant option is used)			     [kg/m^3 ]
!   PLAST_NAME:   plastic name										 [-      ]
!	PLAST_SHAP:
!   PLAST_AAXI:	  longest axis of the plastics 	    				 [mm     ]
!	PLAST_BAXI:   medium axis of the plastics	    				 [mm     ]
!	PLAST_CAXI:   shortest axis of the plastics         			 [mm     ]
!   PLAST_PRHO:   plastic density                                    [kg/m^3 ]
!------------------------------------------------------------------------------!

NPLAST = 1

PLAST_NAME = mp1
PLAST_SHAP = sphere
PLAST_AAXI = 0.040 
PLAST_BAXI = 0.040
PLAST_CAXI = 0.040
PLAST_PRHO = 1025.
PLAST_PRAT = 0.0

!-------------------------------------------------------------------------------!
!Ambient environment parameters, including the bed character (constant), and
!the ambient water density (constant).	
!	   
!   SED_PORS:   porosity, Vwater/(Vwater+Vsed) (if set constant)     [-      ]
!   SED_SD50:   mean sediment diameter (if set constant)             [mm     ]
!	SED_SRHO:   sediment density  (it set constant)                  [kg/m^3 ]
!   SED_MUDP:   mud portion in the sediment	(if set constant)		 [-      ]	
!   AMBIENT_DEN: ambient water density 								 [kg/m^3 ]								  
!   INI_MASS:	initial plastic mass on each grid point 	 		 [kg     ]
!	INF_PLAST:  infinite mass switch
!-------------------------------------------------------------------------------!

SED_SRHO = 1025.
SED_PORS = .5
SED_SD50 = 0.5
SED_MUDP = 0.1

AMBIENT_DEN = 1025.

INI_MASS = 0.0001
INF_PLAST = F

!-------------------------------------------------------------------------------!
!Toxic vector module: 
! If toxic vector module is turned-on. The first-order consecutive chemical 
! reaction processes will be included as the micro-plastic transport. The 
! chemcial will be release as tracer.
!
! TOX_VECTOR: the switch for turning on or off the toxic vector module
! TOX_MOD: Toxic leaching mode 'SFOK'/'SI-FOK'/'SIR-FOK'
! TOX_NAME: Toxic name												 [-      ]
! TOX_CKL: Toxic releasing rate from bonded state 					 [1/s    ]
! TOX_CKD: Toxic decaying rate										 [1/s    ]
! TOX_CKG: Toxic generation rate									 [1/s    ]
! TOX_INR: Initial bottom toxic ratio								 [-		 ]
!-------------------------------------------------------------------------------!

TOX_VECTOR = F
TOX_MOD = SFOK
TOX_NAME = 'BPA'
TOX_CKL = 0.3
TOX_CKD = 0.0
TOX_CKG = 0.0
TOX_INR = 0.001