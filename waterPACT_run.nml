 &NML_CASE
 CASE_TITLE      = 'waterPACT'
 TIMEZONE        = 'none',
 DATE_FORMAT     = 'YMD'
 START_DATE      = 'seconds=0.0'
 END_DATE        = 'days=25.0'
 /

 &NML_STARTUP
